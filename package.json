{
  "name": "reson-music",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sbom": "npm sbom --package-lock-only --sbom-type=application --sbom-format=cyclonedx > sbom.cdx.json && npm sbom --package-lock-only --sbom-type=application --sbom-format=spdx > sbom.spdx.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
